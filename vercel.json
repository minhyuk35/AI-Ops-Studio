{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/demo-store/",
      "framework": "vite"
    },
    "core_api": {
      "root": "services/core-api/",
      "entrypoint": "app.main:app",
      "functions": {
        "app/main.py": {
          "maxDuration": 120
        }
      },
      "routes": [
        {
          "src": "/api/core/(.*)",
          "transforms": [{ "type": "request.path", "op": "set", "args": "/$1" }]
        }
      ]
    },
    "commerce_api": {
      "root": "services/mock-commerce-api/",
      "entrypoint": "app.main:app",
      "functions": {
        "app/main.py": {
          "maxDuration": 30
        }
      },
      "routes": [
        {
          "src": "/api/commerce/(.*)",
          "transforms": [{ "type": "request.path", "op": "set", "args": "/$1" }]
        }
      ]
    }
  },
  "rewrites": [
    { "source": "/api/core/(.*)", "destination": { "service": "core_api" } },
    { "source": "/api/commerce/(.*)", "destination": { "service": "commerce_api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ],
  "crons": [
    { "path": "/api/core/internal/cron/daily-seller-reports", "schedule": "0 0 * * *" },
    { "path": "/api/core/internal/cron/platform-traffic", "schedule": "0 1 * * *" },
    { "path": "/api/core/internal/cron/monthly-market-share", "schedule": "0 1 1 * *" }
  ]
}
