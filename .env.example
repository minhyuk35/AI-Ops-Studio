# Application
APP_ENV=development
APP_NAME=AI Ops Studio API
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
CORE_API_URL=http://localhost:8000
MOCK_COMMERCE_API_URL=http://localhost:8001
MOCK_COMMERCE_TIMEOUT_SECONDS=10
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# OpenRouter
# API Key는 https://openrouter.ai/keys 에서 발급 (비밀값, config에 넣지 않음)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Langfuse prompt config에 model이 없거나 Langfuse를 못 쓸 때만 사용하는 fallback 모델
OPENROUTER_DEFAULT_MODEL=~google/gemini-flash-latest
OPENROUTER_HTTP_REFERER=http://localhost:5173
OPENROUTER_APP_TITLE=AI Ops Studio
OPENROUTER_TIMEOUT_SECONDS=30

# Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com
LANGFUSE_PROMPT_LABEL=production
LANGFUSE_PROMPT_CACHE_TTL_SECONDS=300
LANGFUSE_SAMPLE_RATE=1.0
# 페르소나별 Langfuse prompt name (docs/langfuse-personas.md 참고)
LANGFUSE_SUPPORT_PROMPT_NAME=customer-support-answer
LANGFUSE_TRIAGE_PROMPT_NAME=support-triage
LANGFUSE_COMMERCE_INSIGHT_PROMPT_NAME=commerce-insight
LANGFUSE_MONTHLY_REPORT_PROMPT_NAME=commerce-monthly-report
LANGFUSE_DAILY_SELLER_REPORT_PROMPT_NAME=daily-seller-report
LANGFUSE_PLATFORM_TRAFFIC_PROMPT_NAME=platform-daily-traffic
LANGFUSE_SELLER_MARKET_SHARE_PROMPT_NAME=seller-market-share-report

# 판매자별 일일 리포트를 자동 실행할 시각(UTC, 0~23). 매일 이 시각에 모든
# 활성 판매자를 순회하며 daily-seller-report를 생성해 Discord로 보낸다.
DAILY_REPORT_HOUR_UTC=0
# 관리자 전용 일일 플랫폼 트래픽 리포트를 자동 실행할 시각(UTC, 0~23).
PLATFORM_TRAFFIC_REPORT_HOUR_UTC=1
# 판매자 매출 점유율 비교 리포트를 자동 실행할 날짜(1~28, 매달 이 날 UTC
# PLATFORM_TRAFFIC_REPORT_HOUR_UTC 시각에 실행).
MONTHLY_REPORT_DAY_UTC=1

# Data
# 비워두면(기본값) core-api·mock-commerce-api 모두 SQLite를 그대로 사용합니다
# (COMMERCE_DB_PATH/SUPPORT_DB_PATH 파일 경로). postgres:// 또는 postgresql://
# 로 시작하는 값을 넣으면 두 서비스 모두 psycopg로 해당 Postgres에 연결합니다
# (SQLAlchemy용 postgresql+asyncpg:// 스킴이 아님에 주의). 아직 실제 Postgres
# 인스턴스로 검증되지 않은 경로이므로 운영 전환 전 docs/postgres-migration.md
# 를 먼저 읽으세요. 무료 Postgres 호스팅은 Neon(https://neon.tech) 추천.
DATABASE_URL=
COMMERCE_DB_PATH=data/commerce.db
SUPPORT_DB_PATH=data/support.db
REDIS_URL=redis://localhost:6379/0

# Discord (민감 문의 이관 알림 + 판매자 일일/월간 리포트 전송)
# 디스코드 채널 설정 > 연동 > 웹후크에서 만든 웹후크 URL. 비워두면 알림/전송을 건너뜁니다.
DISCORD_WEBHOOK_URL=
# 관리자 전용 채널 웹훅 (플랫폼 트래픽 + 판매자 매출 점유율 비교). 판매자에게
# 노출되면 안 되는 정보라 위 DISCORD_WEBHOOK_URL과 반드시 다른 채널을 쓴다.
ADMIN_DISCORD_WEBHOOK_URL=

# Auth (mock-commerce-api customer login/signup JWT signing)
# Dev-only fallback exists in code so this can be left blank locally;
# any real deployment must set a random secret here.
AUTH_SECRET_KEY=dev-insecure-secret-change-me-please
# 구글 로그인: Google Cloud Console > API 및 서비스 > 사용자 인증 정보에서
# OAuth 클라이언트 ID(웹 애플리케이션)를 만들고, 승인된 자바스크립트 원본에
# http://localhost:5174(demo-store)를 등록한 뒤 여기와 VITE_GOOGLE_CLIENT_ID에
# 같은 값을 넣는다. 비워두면 구글 로그인 버튼은 안내 메시지만 표시한다.
GOOGLE_CLIENT_ID=

# Frontend
VITE_CORE_API_URL=http://localhost:8000
VITE_COMMERCE_API_URL=http://localhost:8001
# GOOGLE_CLIENT_ID와 동일한 값 (프런트에서 구글 로그인 버튼을 렌더링할 때 사용)
VITE_GOOGLE_CLIENT_ID=
