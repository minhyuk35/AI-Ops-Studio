# Application
APP_ENV=development
APP_NAME=AI Ops Studio API
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
CORE_API_URL=http://localhost:8000
MOCK_COMMERCE_API_URL=http://localhost:8001
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_PROMPT_NAME=customer-support-answer
LANGFUSE_PROMPT_LABEL=production
LANGFUSE_PROMPT_CACHE_TTL_SECONDS=300
LANGFUSE_SAMPLE_RATE=1.0

# Data
DATABASE_URL=postgresql+asyncpg://aiops:aiops@localhost:5432/aiops
COMMERCE_DB_PATH=data/commerce.db
SUPPORT_DB_PATH=data/support.db
REDIS_URL=redis://localhost:6379/0

# Frontend
VITE_CORE_API_URL=http://localhost:8000
VITE_COMMERCE_API_URL=http://localhost:8001
